# PostgreSQL настройки для Open WebUI
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=changeme_secure_password

# DATABASE_URL для скрипта add_users_to_base.py
# Используйте localhost:5432 при подключении извне Docker
DATABASE_URL=postgresql://openwebui:changeme_secure_password@localhost:5432/openwebui
